---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="site-shell">
		<header class="hero">
			<p class="eyebrow">Ijiri Community Association</p>
			<h1>以尻自治会</h1>
			<p class="lead">
				地域のお知らせと、毎日のくらしに役立つ情報をお届けします。
			</p>
		</header>

		<section class="content-grid" aria-label="自治会からのお知らせ">
			<section class="panel">
				<div class="section-heading">
					<p class="section-label">News</p>
					<h2>お知らせ</h2>
				</div>
				<ul class="news-list">
					<li>
						<time datetime="2026-06-09">2026.06.09</time>
						<span>自治会サイトを公開しました。</span>
					</li>
					<li>
						<time datetime="2026-06-09">2026.06.09</time>
						<span>地域行事・回覧情報を順次掲載していきます。</span>
					</li>
				</ul>
			</section>

			<section class="panel">
				<div class="section-heading">
					<p class="section-label">Life</p>
					<h2>くらしの情報</h2>
				</div>
				<div class="life-links">
					<a href="#">ごみ出し</a>
					<a href="#">防災・防犯</a>
					<a href="#">行事予定</a>
					<a href="#">自治会について</a>
				</div>
			</section>
		</section>
	</main>
</Layout>

<style>
	:global(body) {
		background: #f6f3ec;
		color: #232018;
		font-family:
			'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, system-ui, -apple-system,
			BlinkMacSystemFont, sans-serif;
	}

	.site-shell {
		box-sizing: border-box;
		min-height: 100vh;
		padding: 56px 20px;
	}

	.hero,
	.content-grid {
		width: min(1040px, 100%);
		margin: 0 auto;
	}

	.hero {
		padding: 72px 0 48px;
		border-bottom: 1px solid #ded5c5;
	}

	.eyebrow,
	.section-label {
		margin: 0;
		color: #7a5a30;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 18px;
		font-size: clamp(48px, 8vw, 96px);
		line-height: 1.05;
		letter-spacing: 0;
	}

	.lead {
		max-width: 680px;
		margin-bottom: 0;
		color: #5f584e;
		font-size: 20px;
		line-height: 1.8;
	}

	.content-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
		gap: 24px;
		padding-top: 32px;
	}

	.panel {
		padding: 28px;
		background: #fffdfa;
		border: 1px solid #e5dccd;
		border-radius: 8px;
	}

	.section-heading {
		margin-bottom: 24px;
	}

	h2 {
		margin-bottom: 0;
		font-size: 28px;
		line-height: 1.3;
	}

	.news-list {
		display: grid;
		gap: 18px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.news-list li {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 16px;
		padding-bottom: 18px;
		border-bottom: 1px solid #eee7dc;
		line-height: 1.7;
	}

	.news-list li:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}

	time {
		color: #7a7166;
		font-size: 14px;
	}

	.life-links {
		display: grid;
		gap: 12px;
	}

	.life-links a {
		display: block;
		padding: 16px 18px;
		color: #232018;
		background: #f8f3ea;
		border: 1px solid #eadfce;
		border-radius: 8px;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	.life-links a:hover {
		background: #f1e7d7;
		border-color: #d4c3aa;
	}

	@media (max-width: 760px) {
		.site-shell {
			padding: 28px 16px;
		}

		.hero {
			padding: 44px 0 36px;
		}

		.lead {
			font-size: 17px;
		}

		.content-grid,
		.news-list li {
			grid-template-columns: 1fr;
		}

		.news-list li {
			gap: 4px;
		}

		.panel {
			padding: 22px;
		}
	}
</style>
